---
import Layout from "../layouts/Layout.astro";
import DBComposeDownload from "../components/downloads/DBComposeDownload";

Astro.params.lang = "es";
---

<Layout
	title="DBCompose | Downloads"
	description="Descargar la última versión de DBCompose."
>
	<section class="flex min-h-[70vh] items-center justify-center">
		<div
			class="w-full max-w-xl overflow-hidden rounded-lg border border-primary/30 bg-bg-dark/70 shadow-sm shadow-primary/20"
		>
			<div class="flex flex-col items-center gap-4 px-6 py-8 text-center sm:px-10">
				<img
					src="https://files.efrask.dev/dbcompose/logo.png"
					alt="DBCompose"
					class="size-20 rounded-md object-contain"
					onerror="this.remove()"
				/>

				<div class="flex flex-col gap-1">
					<h1 class="font-raleway text-3xl font-bold uppercase tracking-wide text-bg-light">
						DBCompose
					</h1>
					<p class="font-montserrat text-primary-light">
						Constructor visual de consultas para PostgreSQL
					</p>
				</div>

				<div class="w-full pt-2">
					<DBComposeDownload client:load />
				</div>
			</div>
		</div>
	</section>
</Layout>
