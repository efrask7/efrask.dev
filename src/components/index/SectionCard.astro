---
const { title } = Astro.props;
---

<section
  class="rounded-lg overflow-hidden border border-primary/30 bg-bg-dark/70 shadow-sm shadow-primary/20"
  id={title}
>
  <div class="bg-primary/15 px-2 border-b border-primary/20">
    <h2 class="text-md font-bold uppercase font-mono text-primary-light">{title}</h2>
  </div>

  <div class="p-2">
    <slot />
  </div>
</section>
